<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?colorPrimary">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/color_stroke"
        android:layout_width="35dp"
        android:layout_height="35dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:src="@drawable/circle_color_image"
        android:layout_margin="2dp"

        />

<androidx.appcompat.widget.AppCompatImageView
    android:id="@+id/color_circle"
    android:layout_width="35dp"
    android:layout_height="35dp"
    app:layout_constraintTop_toTopOf="@id/color_stroke"
    app:layout_constraintStart_toStartOf="@id/color_stroke"
    app:layout_constraintEnd_toEndOf="@id/color_stroke"
    app:layout_constraintBottom_toBottomOf="@id/color_stroke"
    android:src="@drawable/circle_color_image"
    android:layout_marginStart="4dp"
    android:layout_margin="2dp"
    android:padding="2dp"
    />




</androidx.constraintlayout.widget.ConstraintLayout>