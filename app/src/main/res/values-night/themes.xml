<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ShopList" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorAccentDark</item>
        <item name="android:textColor">@color/white</item>
        <item name="colorPrimaryDark" tools:targetApi="23" >@color/black</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>



        <!-- background for bottom nav. -->
        <item name="bottomNavigationStyle">@style/MyBottomNav</item>
        <item name="bottom_nav_activated_color">@color/white</item>
        <item name="bottom_nav_no_activated_color">@color/gray_item</item>



        <!-- for edit text. -->
        <item name="editTextStyle">@style/myEditText</item>


        <!-- background for system bar. -->
        <item name="android:navigationBarColor">@color/colorPrimary</item>

        <!-- background for toolbar. -->
        <item name="colorSurface">@color/colorPrimary</item>


        <!-- Secondary brand color. -->
        <item name="android:textColorSecondary">@color/text_hint</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccentDark</item>
        <item name="colorOnSecondary">@color/colorAccentDark</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor" >@color/black</item>


        <!-- Action bar. -->
        <!-- Customize your theme here. -->

        <!-- Dialog theme. -->
        <item name="dialog_clicked_item_color">@color/colorPrimaryDark</item>

        <!-- For pref toolbar. -->
        <item name="preferenceTheme">@style/AppTheme.PreferenceThemeOverlay</item>


        <!-- For pref collapsing appbar. -->
        <item name="grad_app_bar_start">@color/colorPrimaryDark</item>
        <item name="grad_app_bar_end">@color/colorPrimary</item>

    </style>
</resources>