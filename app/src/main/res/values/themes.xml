<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ShopList" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimaryDay</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDarkDay</item>
        <item name="colorAccent">@color/colorAccentDay</item>
        <item name="colorOnPrimary">@color/colorAccentDarkDay</item>
        <item name="android:textColor">@color/black</item>
        <item name="colorPrimaryDark" tools:targetApi="23" >@color/black</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>


        <!-- background for bottom nav. -->
        <item name="bottom_nav_activated_color">@color/black</item>
        <item name="bottom_nav_no_activated_color">@color/gray</item>



        <!-- for edit text. -->

        <item name="editTextStyle">@style/myEditText</item>


        <!-- background for system bar. -->
        <item name="android:navigationBarColor">@color/colorPrimaryDay</item>
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi"> true </item>

        <!-- Secondary brand color. -->
        <item name="android:textColorSecondary">@color/text_hint</item>
        <item name="colorSecondary">@color/colorAccentDay</item>
        <item name="colorSecondaryVariant">@color/colorAccentDarkDay</item>
        <item name="colorOnSecondary">@color/colorAccentDarkDay</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor" >@color/black</item>


        <!-- Action bar. -->


        <!-- Customize your theme here. -->

        <!-- Dialog theme. -->
        <item name="dialog_clicked_item_color">@color/card_clicked_day</item>


        <!-- For pref toolbar. -->
        <item name="preferenceTheme">@style/AppTheme.PreferenceThemeOverlay</item>

        <!-- For pref collapsing appbar. -->
        <item name="grad_app_bar_start">@color/card_clicked_day</item>
        <item name="grad_app_bar_end">@color/colorPrimaryDay</item>


        <!-- For items. -->
       <item name="item_color">@color/card_clicked_day</item>
        <item name="item_ready_color">@color/white</item>


        <!-- For list pref. -->
        <item name="alertDialogTheme">@style/MyListPrefWindow</item>



    </style>
</resources>