<resources>



    <style name="NightActionBar" parent="ThemeOverlay.MaterialComponents.ActionBar">
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="endIconTint">@color/white</item>
        <item name="height">50dp</item>
        <item name="popupMenuBackground">@color/colorAccent</item>
        <item name="background">@color/colorPrimary</item>

    </style>

    <style name="DayActionBar" parent="ThemeOverlay.MaterialComponents.ActionBar">
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColor">@color/black</item>
        <item name="endIconTint">@color/black</item>
        <item name="height">50dp</item>
        <item name="popupMenuBackground">@color/colorAccentDay</item>
        <item name="background">@color/colorPrimaryDay</item>
    </style>



    <style name="MyBottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
    </style>


    <style name="MyDialog" parent="Theme.AppCompat.Dialog">
   <item name="android:windowAnimationStyle">@style/DialogAnimation</item>
    </style>


    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/view_show_bottom</item>

    </style>
    <style name="Text_andika" />

</resources>
