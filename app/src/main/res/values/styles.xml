<resources>



    <style name="NightActionBar" parent="ThemeOverlay.MaterialComponents.ActionBar">
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="height">50dp</item>
        <item name="popupMenuBackground">@color/colorPrimary</item>

    </style>

    <style name="DayActionBar" parent="ThemeOverlay.MaterialComponents.ActionBar">
        <item name="android:textColorPrimary">@color/black</item>
        <item name="endIconTint">@color/black</item>
        <item name="android:textColor">@color/black</item>
        <item name="height">50dp</item>
        <item name="popupMenuBackground">@color/white</item>
    </style>

<style name="MyMenu" parent="TextAppearance.AppCompat.Widget.ActionBar.Menu">

</style>


    <style name="MyBottomNavNight" parent="Widget.MaterialComponents.BottomNavigationView">
   <item name="android:colorPrimary">@color/colorPrimaryDark</item>
        <item name="android:background">@color/colorPrimaryDark</item>
        <item name="itemTextColor">@color/white</item>
    </style>


    <style name="MyBottomNavDay" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:colorPrimary">@color/colorPrimaryDarkDay</item>
        <item name="android:background">@color/colorPrimaryDarkDay</item>
        <item name="itemTextColor">@color/black</item>
    </style>


    <style name="MyDialog" parent="Theme.AppCompat.Dialog">
   <item name="android:windowAnimationStyle">@style/DialogAnimation</item>
    </style>


    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/view_show_bottom</item>

    </style>
    <style name="Text_andika" />

</resources>
